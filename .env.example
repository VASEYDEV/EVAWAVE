# EVAWAVE environment variables (BUILD-BRIEF §6). Copy to .env.local and fill in.
# Never commit real values: .env* is gitignored, and only this file is tracked.
# Names without the NEXT_PUBLIC_ prefix are server-only; the gate fails the build if any
# of them appears in the client bundle (scripts/check-client-bundle.sh).

# Supabase (S7 provisions the project). Public: RLS enforces access.
# While these are unset, src/proxy.ts passes requests through without a session refresh.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role. Server only; bypasses RLS. Not read by any code yet.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API for the S8 text-intake route. Server only. Not read by any code yet.
ANTHROPIC_API_KEY=
# Pin explicitly. Verify the current model id against the Anthropic API docs when S8
# lands, rather than hard-coding one from memory.
INTAKE_MODEL=

# App identity (VASEY/AI tool). Not read by any code yet.
APP_NAME=EVAWAVE
BRAND_LOCKUP=EVAWAVE
